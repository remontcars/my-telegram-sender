{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "@vercel/php@0.7.0" // Оставляем ту же версию рантайма
    }
    // Если у вас есть статические файлы (HTML, CSS, JS) в папке public,
    // раскомментируйте и настройте следующую секцию:
    // {
    //   "src": "public/**",
    //   "use": "@vercel/static"
    // }
  ]
  // Если вам нужна маршрутизация (например, все запросы на / перенаправлять на api/index.php)
  // добавьте секцию routes. Пример:
  // "routes": [
  //   { "src": "/(.*)", "dest": "/api/index.php" }
  // ]
}